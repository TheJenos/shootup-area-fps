{
  "name": "discord-flag-fps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "emulator": "firebase emulators:start --only database --project demo-fps",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "check:maps": "rolldown scripts/check-maps.ts --platform node --format esm --file node_modules/.cache/check-maps.mjs --log-level warn && node node_modules/.cache/check-maps.mjs",
    "build:props": "node scripts/build-props.mjs",
    "test:rules": "firebase emulators:exec --only database --project demo-fps \"node scripts/test-rules.mjs\"",
    "deploy:rules": "firebase deploy --only database --non-interactive"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@discord/embedded-app-sdk": "^2.5.0",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
