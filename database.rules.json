{
  "rules": {
    "lobby": {
      ".read": true,
      "$room": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'createdAt']) || !newData.exists()",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "seed": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "mode": {
          ".validate": "newData.val() === 'ffa' || newData.val() === 'tdm' || newData.val() === 'ctf' || newData.val() === 'gungame'"
        },
        "members": {
          "$pid": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          }
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": true,
        ".write": true,
        "players": {
          "$pid": {
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "hp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            }
          }
        }
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": [
        "score"
      ],
      "$pid": {
        ".write": "$pid.matches(/^[pd]_[A-Za-z0-9_-]{6,40}$/)",
        ".validate": "newData.hasChildren(['name', 'kills', 'deaths', 'captures', 'wins', 'rounds', 'score'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "kills": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100"
        },
        "deaths": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100"
        },
        "captures": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 10"
        },
        "wins": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        },
        "rounds": {
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() === newData.parent().child('kills').val() * 10 + newData.parent().child('captures').val() * 30 + newData.parent().child('wins').val() * 50"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
