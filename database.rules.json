{
  "rules": {
    "lobby": {
      ".read": true,
      "$room": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'createdAt']) || !newData.exists()",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "seed": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "mode": {
          ".validate": "newData.val() === 'ffa' || newData.val() === 'tdm' || newData.val() === 'ctf' || newData.val() === 'gungame' || newData.val() === 'sniper' || newData.val() === 'snipertdm'"
        },
        "members": {
          "$pid": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          }
        },
        "rules": {
          ".validate": "newData.hasChildren(['base', 'name', 'short', 'loadout', 'limit', 'minutes', 'health', 'respawn', 'speed', 'gravity']) && newData.child('base').val() === newData.parent().child('mode').val()",
          "base": {
            ".validate": "newData.val() === 'ffa' || newData.val() === 'tdm' || newData.val() === 'ctf'"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "short": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 4"
          },
          "loadout": {
            ".validate": "newData.val() === 'standard' || newData.val() === 'gungame' || newData.val() === 'rifle' || newData.val() === 'shotgun' || newData.val() === 'sniper' || newData.val() === 'deagle'"
          },
          "guns": {
            ".validate": "newData.isBoolean()"
          },
          "abilities": {
            ".validate": "newData.isBoolean()"
          },
          "ammo": {
            ".validate": "newData.isBoolean()"
          },
          "headshotsOnly": {
            ".validate": "newData.isBoolean()"
          },
          "limit": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 150"
          },
          "minutes": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 20"
          },
          "health": {
            ".validate": "newData.isNumber() && newData.val() >= 25 && newData.val() <= 200"
          },
          "respawn": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
          },
          "speed": {
            ".validate": "newData.isNumber() && newData.val() >= 0.7 && newData.val() <= 1.5"
          },
          "gravity": {
            ".validate": "newData.isNumber() && newData.val() >= 0.3 && newData.val() <= 1.5"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": true,
        ".write": true,
        "players": {
          "$pid": {
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "hp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
            }
          }
        }
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": [
        "score"
      ],
      "$pid": {
        ".write": "$pid.matches(/^[pd]_[A-Za-z0-9_-]{6,40}$/)",
        ".validate": "newData.hasChildren(['name', 'kills', 'deaths', 'captures', 'wins', 'rounds', 'score'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "kills": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100"
        },
        "deaths": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100"
        },
        "captures": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 10"
        },
        "wins": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        },
        "rounds": {
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() === newData.parent().child('kills').val() * 10 + newData.parent().child('captures').val() * 30 + newData.parent().child('wins').val() * 50"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "guildboard": {
      "$guild": {
        ".read": true,
        ".indexOn": [
          "score"
        ],
        "$pid": {
          ".write": "$guild.matches(/^[0-9]{5,25}$/) && $pid.matches(/^[pd]_[A-Za-z0-9_-]{6,40}$/)",
          ".validate": "newData.hasChildren(['name', 'kills', 'deaths', 'captures', 'wins', 'rounds', 'score'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "kills": {
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100"
          },
          "deaths": {
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100"
          },
          "captures": {
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 10"
          },
          "wins": {
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
          },
          "rounds": {
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() === newData.parent().child('kills').val() * 10 + newData.parent().child('captures').val() * 30 + newData.parent().child('wins').val() * 50"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
